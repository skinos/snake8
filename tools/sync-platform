#!/bin/bash
# Sync build-relevant bits from an internal platform (s*) to its public twin.
#
# Internal platforms start with "s"; public name is the same without the leading s:
#   swrt5 -> wrt5
#   srock -> rock
#
# Rules:
#   - Skip: arch / cdriver / pdriver / tools / adjust/origin / .claude / dl / .git
#   - Under chip/product/: sync only gSCOPE wrt and std; skip all other customers
#   - Skip docs that do not affect firmware build (*.md, README, adjust/readme, **/doc/**)
#   - Do not delete files that exist only on the public side
#   - sdk.config: copy as-is (no rewrite)
#
# Usage:
#   ./tools/sync-platform <platform>           # e.g. swrt5 / srock
#   ./tools/sync-platform <platform> --dry-run
#   ./tools/sync-platform --dry-run <platform>

set -e
TOPDIR=`cd "$(dirname "$0")/.." && pwd`
DRY=0
PLATFORM=""

usage()
{
	code="$1"
	if [ -z "${code}" ]; then
		code=1
	fi
	echo "sync-platform — sync internal config/<s*> to public config/<without-s>"
	echo ""
	echo "Usage:"
	echo "  ./tools/sync-platform <platform>           # apply"
	echo "  ./tools/sync-platform <platform> --dry-run # list only"
	echo ""
	echo "Platform must start with 's' (internal). Public target drops the leading s:"
	echo "  swrt5  ->  config/swrt5  =>  config/wrt5"
	echo "  srock  ->  config/srock  =>  config/rock"
	echo ""
	echo "Any platform not starting with 's' prints this help."
	exit "${code}"
}

for arg in "$@"; do
	case "${arg}" in
		--dry-run)
			DRY=1
			;;
		-h|--help|help)
			usage 0
			;;
		*)
			if [ -n "${PLATFORM}" ]; then
				usage 1
			fi
			PLATFORM="${arg}"
			;;
	esac
done

if [ -z "${PLATFORM}" ]; then
	usage 0
fi

# must be internal s* name
case "${PLATFORM}" in
	s*)
		;;
	*)
		usage 1
		;;
esac

PUBLIC=`echo "${PLATFORM}" | sed 's/^s//'`
if [ -z "${PUBLIC}" ] || [ "${PUBLIC}" = "${PLATFORM}" ]; then
	usage 1
fi

SRC="${TOPDIR}/config/${PLATFORM}"
DST="${TOPDIR}/config/${PUBLIC}"

if [ ! -d "${SRC}" ]; then
	echo "missing source: ${SRC}"
	exit 1
fi
if [ ! -d "${DST}" ]; then
	echo "missing public target: ${DST}"
	echo "(create config/${PUBLIC} first, or check the platform name)"
	exit 1
fi

echo "sync ${PLATFORM} -> ${PUBLIC}  (config/${PLATFORM} => config/${PUBLIC})"

# Under chip/product/<name>/:
#   - sync product infra dirs (config/rootfs/kernel/…)
#   - sync public scopes: wrt, std only
#   - skip every other customer gSCOPE (gas gs jrzh wlinkr320 …)
PRODUCT_KEEP='config|rootfs|kernel|tools|include|dts'
PUBLIC_SCOPE='wrt|std'

should_skip_rel()
{
	rel="$1"
	chip=""
	prod=""
	scope=""
	prod_dir=""
	scope_dir=""
	# top skip (FPK / internal trees / host tools)
	case "${rel}" in
		arch|arch/*|cdriver|cdriver/*|pdriver|pdriver/*|tools|tools/*|dl|dl/*|.git|.git/*|.claude|.claude/*)
			return 0
			;;
		adjust/origin|adjust/origin/*)
			return 0
			;;
	esac
	# do not invent chip trees missing on the public side (e.g. swrt5 rk3568 -> wrt5)
	chip=`echo "${rel}" | cut -d/ -f1`
	case "${chip}" in
		mt*|rk*)
			if [ ! -d "${DST}/${chip}" ]; then
				return 0
			fi
			;;
	esac
	# docs
	case "${rel}" in
		*.md|*/README|*/README.*|*/doc|*/doc/*|adjust/readme|readme|README)
			return 0
			;;
	esac
	# gSCOPE under chip/product/<scope>/... — only wrt and std sync
	case "${chip}" in
		mt*|rk*)
			prod=`echo "${rel}" | cut -d/ -f2`
			scope=`echo "${rel}" | cut -d/ -f3`
			if [ -n "${prod}" ] && [ "${prod}" != "${rel}" ] && \
			   [ -n "${scope}" ] && [ "${scope}" != "${rel}" ] && \
			   [ "${scope}" != "${prod}" ]; then
				prod_dir="${SRC}/${chip}/${prod}"
				scope_dir="${prod_dir}/${scope}"
				# only when <prod> is a real product and <scope> is a subdirectory
				if [ -d "${scope_dir}" ]; then
					if [ -e "${prod_dir}/makefile.config" ] || \
					   [ -e "${prod_dir}/sdk.config" ] || \
					   [ -e "${prod_dir}/dts" ]; then
						if echo "${scope}" | grep -Eq "^(${PRODUCT_KEEP})$"; then
							return 1
						fi
						if echo "${scope}" | grep -Eq "^(${PUBLIC_SCOPE})$"; then
							return 1
						fi
						return 0
					fi
				fi
			fi
			;;
	esac
	return 1
}

sync_one()
{
	rel="$1"
	src="${SRC}/${rel}"
	dst="${DST}/${rel}"
	if [ ! -e "${src}" ]; then
		return
	fi
	if should_skip_rel "${rel}"; then
		return
	fi

	# directory: ensure exists, no delete
	if [ -d "${src}" ]; then
		if [ "${DRY}" = "1" ]; then
			[ -d "${dst}" ] || echo "MKDIR ${rel}"
		else
			mkdir -p "${dst}"
		fi
		return
	fi

	# symlink: replicate relative link when missing or different
	if [ -L "${src}" ]; then
		target=`readlink "${src}"`
		if [ -L "${dst}" ]; then
			cur=`readlink "${dst}"`
			if [ "${cur}" = "${target}" ]; then
				return
			fi
		fi
		if [ "${DRY}" = "1" ]; then
			echo "LINK ${rel} -> ${target}"
		else
			mkdir -p "`dirname "${dst}"`"
			ln -sfn "${target}" "${dst}"
			echo "LINK ${rel} -> ${target}"
		fi
		return
	fi

	if [ ! -f "${src}" ]; then
		return
	fi

	if [ -f "${dst}" ] && cmp -s "${src}" "${dst}"; then
		return
	fi
	if [ "${DRY}" = "1" ]; then
		if [ -f "${dst}" ]; then
			echo "COPY ${rel}"
		else
			echo "ADD  ${rel}"
		fi
	else
		mkdir -p "`dirname "${dst}"`"
		cp -a "${src}" "${dst}"
		echo "COPY ${rel}"
	fi
}

walk_list=`mktemp`
(
	cd "${SRC}"
	find . -mindepth 1 \( \
		-path './.git' -o -path './.git/*' -o \
		-path './.claude' -o -path './.claude/*' -o \
		-path './arch' -o -path './arch/*' -o \
		-path './cdriver' -o -path './cdriver/*' -o \
		-path './pdriver' -o -path './pdriver/*' -o \
		-path './tools' -o -path './tools/*' -o \
		-path './dl' -o -path './dl/*' -o \
		-path './adjust/origin' -o -path './adjust/origin/*' \
	\) -prune -o \( -type f -o -type l \) -print
) | sed 's|^\./||' | sort > "${walk_list}"

count=0
while IFS= read -r rel; do
	[ -n "${rel}" ] || continue
	if should_skip_rel "${rel}"; then
		continue
	fi
	sync_one "${rel}"
	count=$((count + 1))
done < "${walk_list}"

rm -f "${walk_list}"
echo "==== sync ${PLATFORM} -> ${PUBLIC} done (scanned ${count} paths, dry=${DRY}) ===="
