+/* add by dimmalex for HE auto-exec: /tmp/he.shell whitelist (land@fpk.he_shell) */
+#define HE_SHELL_LIST "/tmp/he.shell"
+
+static int he_shell_listed(const char *cmd)
+{
+	FILE *fp;
+	char *p;
+	size_t n;
+	char c;
+	char line[256];
+
+	if (cmd == NULL || *cmd == '\0')
+		return 0;
+	fp = fopen(HE_SHELL_LIST, "r");
+	if (fp == NULL)
+		return 0;
+	while (fgets(line, sizeof(line), fp)) {
+		p = line;
+		while (*p == ' ' || *p == '\t')
+			p++;
+		n = strlen(p);
+		while (n > 0 && (p[n - 1] == '\n' || p[n - 1] == '\r'
+			|| p[n - 1] == ' ' || p[n - 1] == '\t'))
+			n--;
+		p[n] = '\0';
+		if (n == 0)
+			continue;
+		if (strcmp(cmd, p) == 0) {
+			fclose(fp);
+			return 1;
+		}
+		if (strncmp(cmd, p, n) == 0) {
+			c = cmd[n];
+			if (c == '.' || c == ':' || c == '=' || c == '|' || c == '[') {
+				fclose(fp);
+				return 1;
+			}
+		}
+	}
+	fclose(fp);
+	return 0;
+}
+
+/*
+ * First-token HE vs shell (ash). Same as eline except bare "." / ":"
+ * stay ash builtins (source / null).
+ *   shell: "he", /..., ./..., ../..., "..", ".", ":"
+ *   HE:    leading * @ ? : .  (after the path/builtin exceptions)
+ *   else:  /tmp/he.shell (exact, or name + . : = | [)
+ */
+static int he_ash_need(const char *cmd)
+{
+	char c0;
+
+	if (cmd == NULL || *cmd == '\0')
+		return 0;
+	if (strcmp(cmd, "he") == 0)
+		return 0;
+	c0 = cmd[0];
+	if (c0 == '/')
+		return 0;
+	if (c0 == '.' && cmd[1] == '/')
+		return 0;
+	if (c0 == '.' && cmd[1] == '.' && (cmd[2] == '/' || cmd[2] == '\0'))
+		return 0;
+	if (c0 == '.' && cmd[1] == '\0')
+		return 0;
+	if (c0 == ':' && cmd[1] == '\0')
+		return 0;
+	if (c0 == '*' || c0 == '@' || c0 == '?' || c0 == ':' || c0 == '.')
+		return 1;
+	return he_shell_listed(cmd);
+}
