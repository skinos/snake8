+	/* add by dimmalex for HE component command auto exec via he */
+	if (argc >= 1
+	 && argv[0] != NULL
+	 && argv[0][0] != '\0'
+	 && strcmp(argv[0], "he") != 0
+	 && strchr(argv[0], '@') != NULL
+	 && argv[0][0] != '/'
+	 && !(argv[0][0] == '.' && argv[0][1] == '/')
+	 && !(argv[0][0] == '.' && argv[0][1] == '.' && argv[0][2] == '/')
+	) {
+		he_cmd = strchr(argv[0], '/');
+		he_at = strchr(argv[0], '@');
+		/* '/' before '@' => filesystem path; '/' after '@' may be URL params */
+		if (he_cmd == NULL || he_cmd > he_at) {
+			for (he_i = argc; he_i >= 0; he_i--)
+				argv[he_i + 1] = argv[he_i];
+			argv[0] = (char *)"he";
+			argc++;
+		}
+	}
+
 	/* Now locate the command. */
 	if (cmdentry.cmdtype != CMDBUILTIN
 	 || !(IS_BUILTIN_REGULAR(cmdentry.u.cmd))
 	) {
 		path = path ? path : pathval();
+		find_command(argv[0], &cmdentry, cmd_flag, path);
+	}
+
+	/* short HE name without '@' (machine, service, machine.status, ...) */
+	if (cmdentry.cmdtype == CMDUNKNOWN
+	 && argc == 1
+	 && argv[0] != NULL
+	 && argv[0][0] != '\0'
+	 && strcmp(argv[0], "he") != 0
+	 && argv[0][0] != '/'
+	 && !(argv[0][0] == '.' && argv[0][1] == '/')
+	 && !(argv[0][0] == '.' && argv[0][1] == '.' && argv[0][2] == '/')
+	 && strchr(argv[0], '/') == NULL
+	) {
+		he_cmd = argv[0];
+		argv[0] = (char *)"he";
+		argv[1] = he_cmd;
+		argv[2] = NULL;
+		argc = 2;
+		find_command(argv[0], &cmdentry, cmd_flag, path);
+	}
+
+	if (cmdentry.cmdtype == CMDUNKNOWN) {
 		find_command(argv[0], &cmdentry, cmd_flag | DO_ERR, path);
 	}
 
