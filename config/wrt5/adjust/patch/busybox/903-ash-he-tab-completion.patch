+#if ENABLE_FEATURE_TAB_COMPLETION
+static int he_arg_line(const char *line)
+{
+	const char *p;
+
+	if (line == NULL)
+		return 0;
+	p = line;
+	while (*p == ' ' || *p == '\t')
+		p++;
+	if (p[0] != 'h' || p[1] != 'e')
+		return 0;
+	p += 2;
+	if (*p != ' ' && *p != '\t')
+		return 0;
+	return 1;
+}
+
+static void complete_hetab(const char *basecmd, unsigned baselen)
+{
+	int pfd[2];
+	pid_t pid;
+	char buf[4096];
+	char he_cmd[512];
+	char *line;
+	char *nl;
+	char *hetab_argv[3];
+	char *he_argv[3];
+	size_t pos;
+	ssize_t nr;
+	int wstatus;
+	int devnull;
+
+	if (pipe(pfd) != 0)
+		return;
+
+	pid = fork();
+	if (pid < 0) {
+		close(pfd[0]);
+		close(pfd[1]);
+		return;
+	}
+	if (pid == 0) {
+		close(pfd[0]);
+		xmove_fd(pfd[1], STDOUT_FILENO);
+		devnull = open("/dev/null", O_WRONLY);
+		if (devnull >= 0)
+			xmove_fd(devnull, STDERR_FILENO);
+		hetab_argv[0] = (char *)"hetab";
+		hetab_argv[1] = (char *)basecmd;
+		hetab_argv[2] = NULL;
+		execv("/usr/bin/hetab", hetab_argv);
+		execvp("hetab", hetab_argv);
+		snprintf(he_cmd, sizeof(he_cmd), "?%s", basecmd);
+		he_argv[0] = (char *)"he";
+		he_argv[1] = he_cmd;
+		he_argv[2] = NULL;
+		execv("/usr/bin/he", he_argv);
+		execvp("he", he_argv);
+		_exit(127);
+	}
+	close(pfd[1]);
+	pos = 0;
+	buf[0] = '\0';
+	for (;;) {
+		nr = safe_read(pfd[0], buf + pos, sizeof(buf) - 1 - pos);
+		if (nr <= 0)
+			break;
+		pos += (size_t)nr;
+		buf[pos] = '\0';
+		line = buf;
+		for (;;) {
+			nl = strchr(line, '\n');
+			if (nl == NULL)
+				break;
+			*nl = '\0';
+			if (line[0] != '\0' && strncmp(line, basecmd, baselen) == 0)
+				add_he_match(xstrdup(line));
+			line = nl + 1;
+		}
+		pos = strlen(line);
+		memmove(buf, line, pos + 1);
+	}
+	close(pfd[0]);
+	waitpid(pid, &wstatus, 0);
+	if (buf[0] != '\0' && strncmp(buf, basecmd, baselen) == 0)
+		add_he_match(xstrdup(buf));
+}
+#endif
