+	char *copy;
+
+	add_match(matched);
+	if (num_matches == n)
+		return;
+	/* own copy: matches[] may free duplicates during dedup */
+	copy = xstrdup(matched);
+	he_matches = xrealloc_vector(he_matches, 4, he_num_matches);
+	he_matches[he_num_matches] = copy;
+	he_num_matches++;
+}
