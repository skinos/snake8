+static void free_he_match_data(void)
+{
+	while (he_num_matches)
+		free(he_matches[--he_num_matches]);
+	free(he_matches);
+	he_matches = NULL;
+}
+
+static int match_from_hetab(const char *s)
+{
+	unsigned i;
+
+	for (i = 0; i < he_num_matches; i++) {
+		if (strcmp(he_matches[i], s) == 0)
+			return 1;
+	}
+	return 0;
+}
+#endif
