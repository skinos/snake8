+
+static void mt7603_mcu_poke_reset(struct mt7603_dev *dev)
+{
+	u32 addr = mt7603_reg_map(dev, 0x50012498);
+
+	mt76_wr(dev, addr, 0x5);
+	mt76_wr(dev, addr, 0x5);
+	udelay(1);
+
+	mt76_rmw(dev, MT_SCH_4, MT_SCH_4_FORCE_QID,
+		 MT_SCH_4_BYPASS | FIELD_PREP(MT_SCH_4_FORCE_QID, 5));
+}
+
 static int
 mt7603_mcu_restart(struct mt76_dev *dev)
 {
 	return mt76_mcu_send_msg(dev, -MCU_CMD_RESTART_DL_REQ, NULL, 0, true);
 }
 
+
+static int mt7603_mcu_stop(struct mt7603_dev *dev)
+{
+	int ret;
+
+	ret = mt7603_mcu_restart(&dev->mt76);
+	if (!ret)
+		return 0;
+
+	mt7603_mcu_poke_reset(dev);
+
+	return mt76_poll_msec(dev, MT_TOP_MISC2, BIT(0) | BIT(1), BIT(0), 500) ?
+	       0 : -EIO;
+}
